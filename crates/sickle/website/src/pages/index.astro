---
import Layout from "../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

const sourceCcl = `/= Application configuration
name = Signal
database =
  host = localhost
  port = 5432
features =
  = metrics
  = tracing`;

const directRust = `use sickle::load;

let model = load(ccl)?;
let port = model
  .get("database")?
  .get_int("port")?;

assert_eq!(port, 5432);`;

const serdeRust = `use serde::Deserialize;
use sickle::from_str;

#[derive(Deserialize)]
struct Config {
  name: String,
  database: Database,
}

let config: Config = from_str(ccl)?;`;

const directApiRust = `let model = sickle::load(input)?;
let host = model
  .get("database")?
  .get_string("host")?;`;

const serdeApiRust = `let config: Config =
  sickle::from_str(input)?;

let output =
  sickle::to_string(&config)?;`;

const documentBefore = `/= Keep this explanation
port = 5432
mode = production`;

const documentAfter = `/= Keep this explanation
port = 6432
mode = production`;

const features = [
  {
    name: "parse",
    adds: "Flat entries",
    detail: "Parse CCL into insertion-ordered key-value entries.",
    includes: "core parser",
  },
  {
    name: "hierarchy",
    adds: "Nested model",
    detail: "Build a navigable CclObject from parsed entries.",
    includes: "parse",
  },
  {
    name: "serde",
    adds: "Typed data",
    detail: "Deserialize and serialize through Serde.",
    includes: "hierarchy + printer",
  },
  {
    name: "document",
    adds: "Source fidelity",
    detail: "Edit typed values while preserving comments and formatting.",
    includes: "serde",
  },
  {
    name: "intern",
    adds: "String interning",
    detail: "Reduce repeated string storage in large configurations.",
    includes: "optional dependency",
  },
  {
    name: "full",
    adds: "Complete toolset",
    detail: "Enable parsing, hierarchy, Serde, printing, interning, and documents.",
    includes: "all stable features",
  },
];
---

<Layout
  title="Sickle — CCL parsing for Rust"
  description="A pure Rust parser for CCL with direct model navigation, Serde integration, canonical printing, and source-preserving document edits."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Sickle home">
      <svg viewBox="0 0 34 34" aria-hidden="true">
        <path d="M27 4c-1 13-6 21-18 25 8 1 15-2 20-8" />
        <path d="M9 29 5 25" />
      </svg>
      <span>sickle</span>
    </a>
    <div class="header-status" aria-label="Library status">
      <span class="signal-lamp signal-lamp-green"></span>
      <span>PURE RUST / NO UNSAFE</span>
    </div>
    <nav aria-label="Primary navigation">
      <a href="#apis">APIs</a>
      <a href="#features">Features</a>
      <a href="https://docs.rs/sickle">Docs</a>
      <a href="https://github.com/tylerbutler/santa/tree/main/crates/sickle">Source</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">One language.<br /><span>Two clear routes.</span></h1>
        <p>
          Sickle makes CCL readable in Rust. Navigate the model directly or
          deserialize into the types your program already trusts.
        </p>
      </div>

      <div class="interlocking" data-workbench data-route="serde">
        <div class="panel-ident">
          <span>SICKLE INTERLOCKING / CCL</span>
          <span>INSERTION ORDER PRESERVED</span>
          <span class="panel-ready"><i></i> ROUTE READY</span>
        </div>

        <div class="route-board">
          <svg class="route-diagram" viewBox="0 0 1200 430" preserveAspectRatio="none" aria-hidden="true">
            <path class="track-bed" d="M70 215 H420 C500 215 500 116 590 116 H1120" />
            <path class="track-bed" d="M420 215 C500 215 500 314 590 314 H1120" />
            <path class="track-route track-direct" d="M70 215 H420 C500 215 500 116 590 116 H1120" />
            <path class="track-route track-serde" d="M70 215 H420 C500 215 500 314 590 314 H1120" />
            <circle class="junction-ring" cx="420" cy="215" r="18" />
            <circle class="route-node route-node-direct" cx="590" cy="116" r="10" />
            <circle class="route-node route-node-serde" cx="590" cy="314" r="10" />
          </svg>

          <div class="source-station">
            <div class="station-label">
              <span>ORIGIN</span>
              <strong>input.ccl</strong>
            </div>
            <Code code={sourceCcl} lang="text" frame="none" />
          </div>

          <div class="junction">
            <p>SELECT ROUTE</p>
            <div class="route-switch" role="group" aria-label="Choose API route">
              <button type="button" data-mode="direct" aria-pressed="false">
                <span class="signal-lamp"></span>
                Direct model
              </button>
              <button type="button" data-mode="serde" aria-pressed="true">
                <span class="signal-lamp"></span>
                Serde
              </button>
            </div>
          </div>

          <div class="install-rail">
            <div class="install-status">
              <span class="signal-lamp signal-lamp-amber"></span>
              <span>CLEAR TO INSTALL</span>
            </div>
            <code data-install-command>cargo add sickle --features serde</code>
            <button class="copy-button" type="button" data-copy="cargo add sickle --features serde">
              <span data-copy-label>Copy command</span>
            </button>
            <p class="copy-status" role="status" aria-live="polite"></p>
          </div>

          <div class="destination-station">
            <div class="code-output" data-panel="direct" hidden>
              <div class="station-label">
                <span>ROUTE D</span>
                <strong>model.rs</strong>
              </div>
              <Code code={directRust} lang="rust" frame="none" />
            </div>

            <div class="code-output is-active" data-panel="serde">
              <div class="station-label">
                <span>ROUTE S</span>
                <strong>typed.rs</strong>
              </div>
              <Code code={serdeRust} lang="rust" frame="none" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="api-section" id="apis" aria-labelledby="api-title">
      <div class="section-copy">
        <h2 id="api-title">Choose the route.<br />Keep the language.</h2>
        <p>
          Both APIs preserve CCL semantics and share the same hierarchy and
          error model. Start at the level your application needs.
        </p>
      </div>

      <div class="api-lines">
        <article>
          <div class="line-marker">
            <span>D</span>
            <i></i>
          </div>
          <div>
            <h3>Inspect the structure yourself.</h3>
            <p>
              Parse into a hierarchical <code>CclObject</code>, preserve insertion
              order, and access strings, integers, lists, and nested records directly.
            </p>
            <Code code={directApiRust} lang="rust" frame="none" />
          </div>
        </article>

        <article>
          <div class="line-marker line-marker-serde">
            <span>S</span>
            <i></i>
          </div>
          <div>
            <h3>Let your types define the shape.</h3>
            <p>
              Deserialize CCL into existing Rust types, or serialize those values
              back to canonical CCL with separately selectable feature gates.
            </p>
            <Code code={serdeApiRust} lang="rust" frame="none" />
          </div>
        </article>
      </div>
    </section>

    <section class="feature-section" id="features" aria-labelledby="feature-title">
      <div class="feature-copy">
        <h2 id="feature-title">Signal only what the job requires.</h2>
        <p>
          Default features are empty. Build from the core parser to the complete
          document toolchain without pulling every capability into every binary.
        </p>
      </div>

      <div class="feature-board" role="list" aria-label="Cargo feature routes">
        <div class="feature-head" aria-hidden="true">
          <span>signal</span>
          <span>capability</span>
          <span>route includes</span>
        </div>
        {features.map((feature, index) => (
          <article class="feature-row" role="listitem">
            <div class="feature-signal">
              <span class:list={["signal-lamp", { "signal-lamp-amber": index < 5, "signal-lamp-green": index === 5 }]}></span>
              <h3>{feature.name}</h3>
            </div>
            <div>
              <strong>{feature.adds}</strong>
              <p>{feature.detail}</p>
            </div>
            <code>{feature.includes}</code>
          </article>
        ))}
      </div>

      <div class="feature-command">
        <span>ALL ROUTES CLEAR</span>
        <code>cargo add sickle --features full</code>
        <button class="copy-button copy-button-light" type="button" data-copy="cargo add sickle --features full">
          <span data-copy-label>Copy command</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="document-section" aria-labelledby="document-title">
      <div class="document-copy">
        <h2 id="document-title">Change one value.<br />Leave the line intact.</h2>
        <p>
          The optional <code>document</code> API merges typed edits back into source
          text, preserving comments and formatting around the values your
          application changed.
        </p>
        <a href="https://docs.rs/sickle/latest/sickle/document/index.html">
          Inspect the document API
          <svg viewBox="0 0 28 16" aria-hidden="true">
            <path d="M1 8h24M19 2l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="document-routing" aria-label="Source-preserving edit example">
        <div class="document-track" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
        <div class="document-pane">
          <span>BEFORE</span>
          <Code code={documentBefore} lang="text" frame="none" del="5432" />
        </div>
        <div class="document-pane">
          <span>AFTER</span>
          <Code code={documentAfter} lang="text" frame="none" ins="6432" />
        </div>
        <p>ONE TYPED EDIT / ZERO REWRITTEN CONTEXT LINES</p>
      </div>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <h2 id="proof-title">The board tells the truth.</h2>
      <div class="proof-board">
        <div><span class="signal-lamp signal-lamp-green"></span><strong>Pure Rust</strong><span>No unsafe code</span></div>
        <div><span class="signal-lamp signal-lamp-green"></span><strong>Order-aware</strong><span>Insertion order preserved</span></div>
        <div><span class="signal-lamp signal-lamp-green"></span><strong>Test-backed</strong><span>Property and data-driven suites</span></div>
        <div><span class="signal-lamp signal-lamp-green"></span><strong>Independent</strong><span>No dependency on Santa</span></div>
      </div>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">Your route<br />is clear.</h2>
        <p>Add Sickle with the Serde route, or inspect the source before you proceed.</p>
      </div>
      <div class="closing-actions">
        <div class="closing-command">
          <span class="signal-lamp signal-lamp-amber"></span>
          <code>cargo add sickle --features serde</code>
          <button class="copy-button" type="button" data-copy="cargo add sickle --features serde">
            <span data-copy-label>Copy command</span>
          </button>
          <p class="copy-status" role="status" aria-live="polite"></p>
        </div>
        <div class="text-links">
          <a href="https://docs.rs/sickle">Read the docs</a>
          <a href="https://crates.io/crates/sickle">View on crates.io</a>
          <a href="https://github.com/tylerbutler/santa/tree/main/crates/sickle">Browse the source</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="wordmark footer-wordmark" href="/" aria-label="Sickle home">
      <svg viewBox="0 0 34 34" aria-hidden="true">
        <path d="M27 4c-1 13-6 21-18 25 8 1 15-2 20-8" />
        <path d="M9 29 5 25" />
      </svg>
      <span>sickle</span>
    </a>
    <p>A robust CCL parser for Rust. MIT licensed.</p>
  </footer>

  <script>
    const workbench = document.querySelector<HTMLElement>("[data-workbench]");

    if (workbench) {
      const modeButtons = workbench.querySelectorAll<HTMLButtonElement>("[data-mode]");
      const panels = workbench.querySelectorAll<HTMLElement>("[data-panel]");

      modeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedMode = button.dataset.mode;

          if (!selectedMode) return;

          workbench.dataset.route = selectedMode;

          modeButtons.forEach((candidate) => {
            candidate.setAttribute("aria-pressed", String(candidate === button));
          });

          panels.forEach((panel) => {
            const isActive = panel.dataset.panel === selectedMode;
            panel.hidden = !isActive;
            panel.classList.toggle("is-active", isActive);
          });

          const command = selectedMode === "direct"
            ? "cargo add sickle --features hierarchy"
            : "cargo add sickle --features serde";
          const commandDisplay = workbench.querySelector<HTMLElement>("[data-install-command]");
          const copyButton = workbench.querySelector<HTMLButtonElement>("[data-copy]");

          if (commandDisplay) commandDisplay.textContent = command;
          if (copyButton) copyButton.dataset.copy = command;
        });
      });
    }

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const command = button.dataset.copy;
        const label = button.querySelector<HTMLElement>("[data-copy-label]");
        const status = button.parentElement?.querySelector<HTMLElement>(".copy-status");

        if (!command || !label || !status) return;

        try {
          await navigator.clipboard.writeText(command);
          label.textContent = "Copied";
          status.textContent = "Cargo command copied to clipboard.";
          window.setTimeout(() => {
            label.textContent = "Copy command";
          }, 1800);
        } catch {
          label.textContent = "Select command";
          status.textContent = "Clipboard access was blocked. Select and copy the command manually.";
        }
      });
    });
  </script>
</Layout>
